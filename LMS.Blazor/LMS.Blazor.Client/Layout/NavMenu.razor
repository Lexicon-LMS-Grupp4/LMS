@implements IDisposable

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ICurrentUserService CurrentUserService

@using LMS.Shared.DTOs.User
@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <span class="brand-title">Lexicon LMS</span>
            <span class="brand-subtitle">Learning Platform</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler')?.click()">
    <nav class="flex-column">

        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-section">
                    <div class="nav-section-title">Account</div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Account/Login">
                            <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span>
                            Login
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="/Account/Register">
                            <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span>
                            Register
                        </NavLink>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <AuthorizeView Roles="Teacher">
            <Authorized>
                @if (profile is null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else
                {
                    <div class="nav-section">
                        <div class="nav-section-title">teacher</div>
    
                        <div class="nav-item ">
                            <NavLink class="nav-link" href="/admin/courses">
                                <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                                Courses
                            </NavLink>
                        </div>
                    
                        <div class="nav-item ">
                            <NavLink class="nav-link" href="/admin/users">
                                <span class="bi bi-people-nav-menu" aria-hidden="true"></span>
                                Users
                            </NavLink>
                        </div>

                        <div class="nav-item ">
                            <NavLink class="nav-link" href="/admin/submissions">
                                <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                                Submissions
                            </NavLink>
                        </div>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Account</div>

                        <div class="nav-item">
                            <NavLink class="nav-link" href="Account/Manage">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span>
                                @profile.Name
                            </NavLink>
                        </div>

                        <div class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link">
                                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Student">
            <Authorized>
                @if (profile is null)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }

                else
                {
                    <div class="nav-section">
                        <div class="nav-section-title">Student</div>

                        <div class="nav-item ">
                            <NavLink class="nav-link" href="/student/dashboard">
                                <span class="bi bi-grid-nav-menu" aria-hidden="true"></span>
                                Dashboard
                            </NavLink>
                        </div>
                        <div class="nav-item ">
                            <NavLink class="nav-link" href=@($"/courses/{profile.CourseId}")>
                                <span class="bi bi-folder-nav-menu" aria-hidden="true"></span>
                                @profile.CourseName
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="/submissions">
                                <span class="bi bi-folder-nav-menu" aria-hidden="true"></span>
                                Submissions
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="/students">
                                <span class="bi bi-folder-nav-menu" aria-hidden="true"></span>
                                Students
                            </NavLink>
                        </div>
                    </div>

                    <div class="nav-section">
                        <div class="nav-section-title">Account</div>

                        <div class="nav-item">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="Account/Manage">
                                    <span class="bi bi-person-nav-menu" aria-hidden="true"></span>
                                    @profile.Name
                                </NavLink>
                            </div>

                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link">
                                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private UserDto? profile;
    private string? currentUrl;

    protected async override Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            profile = await CurrentUserService.GetMeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
